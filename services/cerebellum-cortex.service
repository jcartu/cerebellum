[Unit]
Description=Cerebellum Cortex (Hypothesis Engine + Arbiter)
After=network-online.target cerebellum-observatory.service
Wants=network-online.target cerebellum-observatory.service

[Service]
Type=simple
WorkingDirectory=/home/josh/.openclaw/cerebellum
User=josh
Group=josh
ExecStart=/home/linuxbrew/.linuxbrew/bin/python3 /home/josh/.openclaw/cerebellum/scripts/arbiter_loop.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/josh/.openclaw/cerebellum/.env
MemoryMax=2G
TasksMax=200

[Install]
WantedBy=default.target
