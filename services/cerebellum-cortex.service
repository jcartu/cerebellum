[Unit]
Description=Cerebellum Cortex (Hypothesis Engine + Arbiter)
After=cerebellum-observatory.service nats.service
Wants=cerebellum-observatory.service

[Service]
Type=simple
WorkingDirectory=/home/josh/.openclaw/cerebellum
ExecStart=/usr/bin/python3 /home/josh/.openclaw/cerebellum/scripts/arbiter_loop.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
