# OpenRouter API Key (required for LLM calls)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Cerebellum Base Directory (optional, defaults to project root)
CEREBELLUM_BASE_DIR=

# Dashboard Auth Token (required for API access)
DASHBOARD_TOKEN=your-secret-token-here

# Telegram Bot Token (optional, for approval notifications)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (optional, for approval notifications)
TELEGRAM_CHAT_ID=

# NATS Auth Token (optional, if NATS requires auth)
CEREBELLUM_NATS_TOKEN=
