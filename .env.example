# OpenRouter API Key (required for LLM calls)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Cerebellum Base Directory (optional, defaults to project root)
CEREBELLUM_BASE_DIR=

# Dashboard Auth Token (required for API access)
DASHBOARD_TOKEN=your-secret-token-here

# Telegram Bot Token (optional, for approval notifications)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (optional, for approval notifications)
TELEGRAM_CHAT_ID=

# NATS Auth Token (optional, if NATS requires auth)
CEREBELLUM_NATS_TOKEN=

# Telegram Webhook Secret (optional, for Telegram webhook auth)
TELEGRAM_WEBHOOK_SECRET=

# Telegram Allowed User IDs (optional, for Telegram approval)
TELEGRAM_ALLOWED_USER_IDS=

# Brave Search API Key (optional, for web.search tool)
BRAVE_SEARCH_API_KEY=

# NATS TLS (optional, for encrypted NATS connections)
CEREBELLUM_NATS_TLS_CA=
CEREBELLUM_NATS_TLS_CERT=
CEREBELLUM_NATS_TLS_KEY=

# Runtime behavior (optional)
CEREBELLUM_LOG_LEVEL=INFO
CEREBELLUM_DRY_RUN=0

# MCP Server (optional, for SSE transport authentication)
CEREBELLUM_MCP_TOKEN=
CEREBELLUM_LOG_LEVEL=INFO
CEREBELLUM_DRY_RUN=0
